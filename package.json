{
  "name": "barcode",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "bundle": "esbuild server.js --bundle --platform=node --target=node16 --external:robotjs --outfile=dist/bundle.js",
    "bundle:20": "esbuild server.js --bundle --platform=node --target=node22 --external:robotjs --outfile=dist/bundle.js",
    "build:exe": "pnpm run tailwind:build && pnpm run bundle && pkg dist/bundle.js --target node16-win-x86 --no-bytecode --public --output dist/BarcodeServer.exe",
    "tailwind:build": "tailwindcss -i ./public/css/style.css -o ./public/css/output.css --minify",
    "tailwind:watch": "tailwindcss -i ./public/css/style.css -o ./public/css/output.css --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "material-symbols": "0.44.10",
    "qrcode": "^1.5.4",
    "robotjs": "0.9.1",
    "tailwindcss": "3.4.19"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "pkg": "5.8.0"
  }
}