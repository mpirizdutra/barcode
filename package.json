{
  "name": "barcode",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "bundle": "esbuild server.js --bundle --platform=node --target=node18 --outfile=dist/bundle.js",
    "build:exe": "npm run bundle && npx pkg dist/bundle.js --targets node16-win-x64 --output dist/BarcodeServer.exe",

    "tailwind:build": "tailwindcss -i ./public/css/style.css -o ./public/css/output.css --minify",
    "tailwind:watch": "tailwindcss -i ./public/css/style.css -o ./public/css/output.css --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "material-symbols": "0.44.10",
    "tailwindcss": "3.4.19"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0",
    "esbuild": "0.28.1"
  }
}